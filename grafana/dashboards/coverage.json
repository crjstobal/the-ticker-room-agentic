      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "tickerroom"
          },
          "queryType": "table",
          "rawQueryText": "SELECT ticker, score FROM sentiment_now WHERE ticker LIKE '$ticker' ORDER BY score DESC",
          "queryText": "SELECT ticker, score FROM sentiment_now WHERE ticker LIKE '$ticker' ORDER BY score DESC",
